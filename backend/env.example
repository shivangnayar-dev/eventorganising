# Environment (development | production)
NODE_ENV=development

# Server Port
PORT=3000

# Database Connection String (MongoDB)
# Local MongoDB: mongodb://localhost:27017/eventorganising
# MongoDB Atlas (Cloud): mongodb+srv://username:password@cluster.mongodb.net/eventorganising?retryWrites=true&w=majority
# Connection string format:
#   - Local: mongodb://[username:password@]host[:port][/database][?options]
#   - Atlas: mongodb+srv://[username:password@]host[/database][?options]
# Common options:
#   - retryWrites=true: Enable retryable writes
#   - w=majority: Write concern (majority for production)
#   - authSource=admin: Authentication database (if different from default)
DATABASE_URL="mongodb://localhost:27017/eventorganising"

# JWT Configuration
# IMPORTANT: In production, JWT_SECRET must be at least 32 characters!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
JWT_EXPIRES_IN="1d"

# CORS Origins (comma-separated)
# Development: Allow multiple origins
# Production: Only your production domain(s)
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# Frontend URL
FRONTEND_URL="http://localhost"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Configuration (for sending notifications)
# For Gmail: Use App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Note: If SMTP is not configured, emails will be logged but not sent
# For production, use a proper email service like SendGrid, AWS SES, etc.

